# =============================================================================
# CONFIGURACIÓN LOCAL DE BASE DE DATOS Y SERVIDOR (SQL SERVER)
# =============================================================================
PORT=4000
NODE_ENV=development

# Modo de Autenticación de SQL Server:
# 'windows' -> Usa Autenticación Integrada de Windows (tu usuario de Windows en SSMS, sin contraseñas).
# 'sql'     -> Usa Autenticación de SQL Server con usuario y contraseña (ej. sa).
DB_AUTH_TYPE=windows

# Servidor SQL Server: '.' o 'localhost' o el nombre de tu máquina
DB_SERVER=.
DB_PORT=1433
DB_DATABASE=prevencion_cognitiva_oltp
DB_ODBC_DRIVER={ODBC Driver 18 for SQL Server}

# Opciones para modo 'sql' (solo si DB_AUTH_TYPE=sql)
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=15000
DB_REQUEST_TIMEOUT=15000

# Seguridad JWT
JWT_SECRET=super_secret_jwt_key_prevencion_cognitiva_g1_trujillo_2026
JWT_EXPIRES_IN=7d

# Zona horaria y localización
TZ=America/Lima
LOCALE=es-PE

# ETL del Data Mart (manual con el botón admin). En Docker apunta a /app/bd-dim-sql.
DATAMART_SCRIPTS_DIR=

# Gemini API (Opcional)
GEMINI_API_KEY=
