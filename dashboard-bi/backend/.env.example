# =============================================================================
# Dashboard BI - Backend (solo lectura del Data Mart)
# Copiar a .env y completar. Nunca subir .env al repositorio.
# =============================================================================
PORT=4001
NODE_ENV=development
TZ=America/Lima

# sqlserver = datos reales del Data Mart (recomendado)
# mock      = datos de prueba deterministas, solo para demos sin base de datos
DATA_SOURCE=sqlserver

# SQL Server. En local se puede apuntar al contenedor sqlserver del compose
# (localhost:1433) o a la instancia que ya tengas.
BI_DB_SERVER=localhost
BI_DB_PORT=1433
BI_DB_DATABASE=prevencion_cognitiva_mart
BI_DB_USER=bi_lector
BI_DB_PASSWORD=
BI_DB_ENCRYPT=true
# true si SQL Server usa un certificado autofirmado (caso habitual en Docker).
BI_DB_TRUST_SERVER_CERTIFICATE=true

# Administrador único del dashboard
ADMIN_USER=admin
# Generar con: pnpm hash -- "TuContraseñaSegura"
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Caché y límites
CACHE_TTL_MS=300000
QUERY_TIMEOUT_MS=15000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000

# Origen permitido para CORS en desarrollo
FRONTEND_ORIGIN=http://localhost:5174
