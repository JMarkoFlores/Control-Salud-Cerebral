{
  "name": "dashboard-bi-backend",
  "private": true,
  "version": "1.0.0",
  "description": "API de solo lectura para el dashboard BI Salud Cerebral",
  "main": "dist/server.js",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "hash": "tsx src/scripts/hash.ts",
    "verify:sql": "tsx src/scripts/verify-sqlserver.ts",
    "test": "tsx --test src/tests/calculations.test.ts src/tests/views.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
