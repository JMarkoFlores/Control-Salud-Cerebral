# Variables del dashboard BI para docker-compose.prod.yml / Dokploy.
# Configúralas en el servicio Compose de Dokploy antes del primer despliegue.

# Login SQL creado por db-init, limitado a SELECT en el esquema bi.
BI_DB_USER=bi_lector
BI_DB_PASSWORD=

# Usuario administrador del dashboard.
BI_ADMIN_USER=
# Genera el hash con: cd dashboard-bi/backend && pnpm hash -- "TuContraseñaSegura"
BI_ADMIN_PASSWORD_HASH=
BI_JWT_SECRET=

# Opcional; clave pública con restricciones por dominio en Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
