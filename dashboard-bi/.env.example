# =============================================================================
# Variables del monorepo para docker-compose / Dokploy.
# Copiar a .env (local) o definirlas en Environment de Dokploy.
# No subir .env al repositorio.
# =============================================================================

# --- SQL Server (una instancia, dos bases: OLTP y Data Mart) ---
MSSQL_SA_PASSWORD=
MSSQL_PID=Developer
MSSQL_MEMORY_LIMIT_MB=1536
TZ=America/Lima

# --- Aplicación transaccional ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Vacío = solo mismo origen. Lista separada por comas si el frontend vive en otro dominio.
CORS_ORIGINS=
# true habilita los botones de acceso demo; false en producción real.
DEMO_LOGIN_ENABLED=false
DB_DATABASE=prevencion_cognitiva_oltp

# --- Inicialización de bases ---
# true solo para cargar datos demo en la primera creación del OLTP.
SEED_DATA=false
RESET_DB=false
RESET_MART=false

# --- Dashboard BI ---
# Login SQL de solo lectura creado por db-mart-init.
BI_DB_USER=bi_lector
BI_DB_PASSWORD=
# Usuario administrador único del dashboard.
BI_ADMIN_USER=
# Hash bcrypt, no la contraseña. En Dokploy va entre comillas simples: '$2b$...'
BI_ADMIN_PASSWORD_HASH=
BI_JWT_SECRET=
BI_JWT_EXPIRES_IN=8h

# --- Opcional ---
# Clave pública de Google Maps restringida al subdominio del dashboard.
VITE_GOOGLE_MAPS_API_KEY=
