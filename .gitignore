# =============================================================================
# GITIGNORE - PREVENCIÓN DEL DETERIORO COGNITIVO (G1)
# =============================================================================

# Dependencias (Node.js)
node_modules/
*/node_modules/
.pnp
.pnp.js

# Variables de entorno y credenciales sensibles (¡NUNCA subir a GitHub!)
.env
.env.*
!.env.example
!*.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Compilación y artefactos de build
dist/
*/dist/
build/
*/build/
out/
*/out/
.next/
.turbo/
.cache/
.parcel-cache/

# Logs del sistema y gestores de paquetes
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cobertura de pruebas (Testing)
coverage/
.nyc_output/

# Archivos de configuración de editores e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Archivos del sistema operativo (Windows y macOS)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Archivos temporales de base de datos local
*.bak
*.mdf
*.ldf
*.sqlite
*.sqlite3

# Scripts de prueba temporales
!backend/src/scripts/testDb.ts
backend/src/scripts/testTemp*.ts
backend/src/scripts/fix*.ts

# Snapshots temporales del navegador automatizado
.playwright-mcp/
