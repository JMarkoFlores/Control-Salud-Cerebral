# Variables para docker-compose.yml / docker-compose.prod.yml.
# Copiar a .env en local o definirlas en Dokploy. No subir .env al repositorio.

# SQL Server: una instancia, dos bases (OLTP + Data Mart).
MSSQL_SA_PASSWORD=
MSSQL_PID=Developer
MSSQL_MEMORY_LIMIT_MB=1536
TZ=America/Lima

# Aplicación transaccional.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Vacío = solo mismo origen. Lista separada por comas si el frontend vive en otro dominio.
CORS_ORIGINS=
DEMO_LOGIN_ENABLED=false
DB_DATABASE=prevencion_cognitiva_oltp

# Inicialización automática.
SEED_DATA=false
RESET_DB=false
RESET_MART=false

# Dashboard BI.
BI_DB_USER=bi_lector
BI_DB_PASSWORD=
BI_ADMIN_USER=
BI_ADMIN_PASSWORD_HASH=
BI_JWT_SECRET=
BI_JWT_EXPIRES_IN=8h

# Opcional.
VITE_GOOGLE_MAPS_API_KEY=
